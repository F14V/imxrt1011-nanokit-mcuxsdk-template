{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{SdkRootDirPath}/mcuxsdk/cmake/toolchain/armgcc.cmake",
      "cacheVariables": {
        "SdkRootDirPath": "$env{SdkRootDirPath}/mcuxsdk",
        "CONFIG_TOOLCHAIN": "armgcc",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "$env{binaryDir}",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "$env{binaryDir}",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "$env{binaryDir}",
        "WEST": "TRUE",
        "board": "imxrt1011-nanokit"
      }
    },
    {
      "name": "debug",
      "binaryDir": "${fileDir}/build/${presetName}",
      "inherits": [
        "debug-env",
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "debug"
      }
    },
    {
      "name": "flexspi_nor_debug",
      "binaryDir": "${fileDir}/build/${presetName}",
      "inherits": [
        "debug-env",
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "flexspi_nor_debug"
      }
    },
    {
      "name": "flexspi_nor_release",
      "binaryDir": "${fileDir}/build/${presetName}",
      "inherits": [
        "release-env",
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "flexspi_nor_release"
      }
    },
    {
      "name": "release",
      "binaryDir": "${fileDir}/build/${presetName}",
      "inherits": [
        "release-env",
        "common"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "flexspi_nor_debug",
      "configurePreset": "flexspi_nor_debug"
    },
    {
      "name": "flexspi_nor_release",
      "configurePreset": "flexspi_nor_release"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "include": [
    "mcux_include.json"
  ]
}
